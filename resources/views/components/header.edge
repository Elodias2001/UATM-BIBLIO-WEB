<header class="w-full bg-white/90 backdrop-blur border-b border-neutral-200">
  <div class="container mx-auto">
    <div class="flex items-center justify-between py-4">
      <a href="/" class="flex items-center gap-3 group">
        <img src="/images/logo/biblio-web-uatm.png" alt="Biblio-Web UATM" class="h-10 w-10 rounded" />
        <div class="leading-tight">
          <div class="text-lg font-semibold text-primary-700 group-hover:text-primary-600 transition-colors">Biblio-Web UATM</div>
          <div class="text-xs text-neutral-500">Bibliothèque des mémoires</div>
        </div>
      </a>

      <nav class="hidden md:flex items-center gap-6 text-sm">
        <a href="#recherche" class="text-neutral-600 hover:text-primary-600 transition-colors">Recherche</a>
        <a href="#thematiques" class="text-neutral-600 hover:text-primary-600 transition-colors">Thématiques</a>
        <a href="#nouveautes" class="text-neutral-600 hover:text-primary-600 transition-colors">Nouveautés</a>
        <a href="#contact" class="text-neutral-600 hover:text-primary-600 transition-colors">Contact</a>
      </nav>

      <div class="flex items-center gap-3">
        <a href="/login" class="text-sm text-neutral-600 hover:text-primary-600 transition-colors">Se connecter</a>
        <a href="/inscription" class="hidden sm:inline-flex items-center gap-2 px-3 py-2 rounded-md bg-primary-600 text-white text-sm hover:bg-primary-700 transition-colors">
          <i class="fa-solid fa-user-plus text-xs"></i>
          <span>Créer un compte</span>
        </a>
      </div>
    </div>
  </div>
</header>
