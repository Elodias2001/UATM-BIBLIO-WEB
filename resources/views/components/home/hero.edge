<section id="recherche" class="relative bg-gradient-to-br from-primary-50 via-white to-accent-50 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 -left-24 h-72 w-72 rounded-full bg-primary-100 blur-3xl opacity-60"></div>
    <div class="absolute -bottom-24 -right-24 h-72 w-72 rounded-full bg-accent-100 blur-3xl opacity-60"></div>
  </div>

  <div class="container mx-auto relative py-14 md:py-24">
    <div class="grid md:grid-cols-2 gap-10 items-center">
      <div class="space-y-6 animate-slide-up">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-100 text-primary-700 text-xs font-semibold">
          <i class="fa-solid fa-graduation-cap"></i>
          Moteur de recherche de mémoires
        </span>
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-neutral-900 leading-tight">
          Trouvez rapidement les mémoires universitaires par mots-clés
        </h1>
        <p class="text-neutral-600 text-base md:text-lg">
          Recherchez par titre, auteur, année, filière ou mots-clés et accédez aux mémoires
          et thèses disponibles à la bibliothèque de l'UATM.
        </p>

        <form id="heroSearchForm" class="mt-4">
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-2">
            <div class="relative flex-1">
              <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-neutral-400"></i>
              <input type="text" id="heroSearchInput" name="q" placeholder="Rechercher un mémoire (mots-clés)" value="{{ request.input('q', '') }}"
                     class="w-full pl-9 pr-4 py-3 rounded-md border border-neutral-300 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-primary-500 placeholder-neutral-400" />
            </div>
            <select id="heroFiliereSelect" name="filiere" class="min-w-[160px] rounded-md border border-neutral-300 py-3 px-3 text-neutral-700 focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-primary-500">
              <option value="">Toutes filières</option>
              <option value="Informatique" {{ request.input('filiere') === 'Informatique' ? 'selected' : '' }}>Informatique</option>
              <option value="Gestion" {{ request.input('filiere') === 'Gestion' ? 'selected' : '' }}>Gestion</option>
              <option value="Sciences" {{ request.input('filiere') === 'Sciences' ? 'selected' : '' }}>Sciences</option>
              <option value="Économie" {{ request.input('filiere') === 'Économie' ? 'selected' : '' }}>Économie</option>
              <option value="Droit" {{ request.input('filiere') === 'Droit' ? 'selected' : '' }}>Droit</option>
            </select>
            <button type="submit" class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-md bg-primary-600 hover:bg-primary-700 text-white font-semibold shadow-sm">
              <i class="fa-solid fa-search"></i>
              Rechercher
            </button>
          </div>
        </form>

        <!-- Résultats de recherche en temps réel -->
        <div id="heroSearchResults" class="mt-6 hidden">
          <div class="bg-white rounded-lg border border-neutral-200 shadow-sm">
            <div class="p-4 border-b border-neutral-200">
              <h3 class="text-lg font-semibold text-neutral-900">Résultats de recherche</h3>
              <p class="text-sm text-neutral-600">Tapez pour rechercher des mémoires</p>
            </div>
            <div id="heroResultsList" class="divide-y divide-neutral-200">
              <!-- Les résultats s'afficheront ici -->
            </div>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3 text-sm text-neutral-500">
          <span class="font-semibold text-neutral-700">Populaire:</span>
          <a href="/search?q=IA" class="px-2 py-1 rounded bg-neutral-100 hover:bg-neutral-200 transition">IA</a>
          <a href="/search?q=Blockchain" class="px-2 py-1 rounded bg-neutral-100 hover:bg-neutral-200 transition">Blockchain</a>
          <a href="/search?q=Réseaux" class="px-2 py-1 rounded bg-neutral-100 hover:bg-neutral-200 transition">Réseaux</a>
          <a href="/search?q=Marketing" class="px-2 py-1 rounded bg-neutral-100 hover:bg-neutral-200 transition">Marketing</a>
        </div>
      </div>

      <div class="relative hidden md:block animate-fade-in">
        <div class="relative mx-auto max-w-md">
          <div class="rounded-xl border border-neutral-200 shadow-md overflow-hidden bg-white">
            <div class="p-4 border-b border-neutral-200 flex items-center justify-between">
              <div class="flex items-center gap-2 text-primary-700 font-semibold">
                <i class="fa-solid fa-book"></i>
                Dernières mémoires
              </div>
              <a href="#nouveautes" class="text-xs text-primary-600 hover:text-primary-700">Tout voir</a>
            </div>
            <ul class="divide-y divide-neutral-200">
              @each(memory in recentMemories)
                <li class="p-4 hover:bg-neutral-50">
                  <div class="text-sm font-semibold text-neutral-800">{{ memory.title }}</div>
                  <div class="text-xs text-neutral-500">Auteur: {{ memory.authors }} — {{ memory.year }}</div>
                </li>
              @else
                <li class="p-4 text-center text-neutral-500 text-sm">
                  Aucun mémoire disponible
                </li>
              @endeach
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const searchForm = document.getElementById('heroSearchForm');
      const searchInput = document.getElementById('heroSearchInput');
      const filiereSelect = document.getElementById('heroFiliereSelect');
      const searchResults = document.getElementById('heroSearchResults');
      const resultsList = document.getElementById('heroResultsList');

      let searchTimeout;

      // Recherche en temps réel
      searchInput.addEventListener('input', function() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(() => {
          performSearch();
        }, 300);
      });

      // Recherche lors du changement de filière
      filiereSelect.addEventListener('change', function() {
        performSearch();
      });

      // Soumission du formulaire
      searchForm.addEventListener('submit', function(e) {
        e.preventDefault();
        performSearch();
      });

      async function performSearch() {
        const query = searchInput.value.trim();
        const filiere = filiereSelect.value;

        if (!query && !filiere) {
          searchResults.classList.add('hidden');
          return;
        }

        try {
          // Utiliser la route GET avec des paramètres de requête pour plus de simplicité
          const params = new URLSearchParams();
          if (query) params.append('q', query);
          if (filiere) params.append('filiere', filiere);

          const response = await fetch(`/search?${params.toString()}`, {
            method: 'GET',
            headers: {
              'X-Requested-With': 'XMLHttpRequest'
            }
          });

          if (!response.ok) {
            throw new Error(`HTTP error! status: ${response.status}`);
          }

          const data = await response.json();
          displayResults(data.results, query, filiere);
        } catch (error) {
          console.error('Erreur de recherche:', error);
          // Afficher un message d'erreur à l'utilisateur
          resultsList.innerHTML = `
            <div class="p-4 text-center text-error-600">
              <i class="fa-solid fa-exclamation-triangle mr-2"></i>
              Erreur lors de la recherche. Veuillez réessayer.
            </div>
          `;
          searchResults.classList.remove('hidden');
        }
      }

      function displayResults(results, query, filiere) {
        if (results.length === 0) {
          resultsList.innerHTML = `
            <div class="p-4 text-center text-neutral-500">
              Aucun résultat trouvé pour "${query}"${filiere ? ` dans ${filiere}` : ''}
            </div>
          `;
        } else {
          resultsList.innerHTML = results.map(memory => `
            <div class="p-4 hover:bg-neutral-50">
              <div class="flex items-start justify-between">
                <div class="flex-1">
                  <div class="font-semibold text-neutral-900 text-sm">${memory.title}</div>
                  <div class="text-xs text-neutral-600">${memory.authors || 'Auteur non spécifié'} — ${memory.year || 'Année non spécifiée'} — ${memory.filiere || 'Filière non spécifiée'}</div>
                  ${memory.abstract ? `<p class="mt-2 text-sm text-neutral-700 line-clamp-2">${memory.abstract.substring(0, 150)}...</p>` : ''}
                  ${memory.keywords ? `
                    <div class="mt-2 flex flex-wrap gap-1 text-xs">
                      ${memory.keywords.split(',').map(tag => `<span class="px-2 py-1 rounded bg-primary-50 text-primary-700 border border-primary-100">${tag.trim()}</span>`).join('')}
                    </div>
                  ` : ''}
                </div>
                <a href="/search?q=${encodeURIComponent(query)}&filiere=${encodeURIComponent(filiere)}" class="text-primary-600 hover:text-primary-700 text-sm ml-4">
                  Voir plus →
                </a>
              </div>
            </div>
          `).join('');
        }

        searchResults.classList.remove('hidden');
      }
    });
  </script>
</section>
